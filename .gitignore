# Keep run inputs/outputs and scratch OUT of version control.
# The tutorial tells learners to keep working files in a private dir — this repo
# models that: never commit datasets, checkpoints, or job artifacts.
*.pdf
agent-labs/
outputs/
checkpoints/
*.pt
*.ckpt

# LaTeX build artifacts. The built deck itself is covered by *.pdf above;
# logos/ is force-added, since it holds real source assets with a .pdf suffix.
slides/*.aux
slides/*.log
slides/*.nav
slides/*.out
slides/*.snm
slides/*.toc
slides/*.vrb
slides/*.fls
slides/*.fdb_latexmk

# Editor / OS cruft
.DS_Store
.vscode/
*.swp

# Python
__pycache__/
*.pyc

# Local agent config that may hold identity/tokens (MAG PAT, IRI/Globus tokens)
.claude/settings.local.json
.env
